{
  "name": "cf-kefu-chat",
  "version": "1.0.0",
  "private": true,
  "description": "在线客服聊天系统 · Cloudflare Workers + D1 + R2",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply cf_kefu --local",
    "db:migrate:remote": "wrangler d1 migrations apply cf_kefu --remote",
    "logs": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
